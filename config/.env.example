# Configuración del backend de alertas P2P/JMA.
# Copiar a config/.env y completar los secretos:
#   cp config/.env.example config/.env
#   chmod 600 config/.env
#
# Generar los tokens con: openssl rand -hex 32
# Nunca subir config/.env al repositorio ni pegarlo en logs o chats.

# ── Modo seguro ────────────────────────────────────────────────────────────────
# true: no llama a la cadena TTS, solo registra el texto exacto en el log.
# Dejar en true hasta haber verificado todo con la prueba de tono autorizada.
DRY_RUN=true

# ── P2PQuake (una sola conexión WebSocket) ─────────────────────────────────────
P2P_WS_URL=wss://api.p2pquake.net/v2/ws
# Solo se admiten 551 (地震情報), 552 (津波予報) y 556 (緊急地震速報).
P2P_CODES=551,552,556
P2P_BACKOFF_INITIAL=1.0
P2P_BACKOFF_FACTOR=2.0
P2P_BACKOFF_MAX=30.0
P2P_BACKOFF_JITTER=0.2
# Tras estos intentos fallidos se avisa una vez a Discord y se sigue reintentando.
P2P_ALERT_AFTER_ATTEMPTS=10
# Eventos más viejos que esto no se anuncian (solo se muestran).
P2P_STALE_EVENT_SECONDS=600

# ── Umbrales de anuncio ────────────────────────────────────────────────────────
# Escala JMA: 45 = 5弱, 50 = 5強. Subir a 50 para anunciar solo 5強 o más.
QUAKE_MIN_SCALE=45
QUAKE_MIN_MAGNITUDE=7.0
EEW_ENABLED=true
# Watch (cualquier tsunami), Warning o MajorWarning.
TSUNAMI_MIN_GRADE=Watch

# ── Tifón ──────────────────────────────────────────────────────────────────────
# La web siempre muestra el tifón; el audio es opcional y por áreas.
TYPHOON_ENABLED=true
# Requiere TYPHOON_AREAS no vacío.
TYPHOON_ANN_TTS=false
# Códigos JMA de 6 dígitos separados por coma, por ejemplo: 130000,140000
TYPHOON_AREAS=
TYPHOON_PROBABILITY_THRESHOLD=30
# Respaldo de JMA; no bajar de 300 s.
TYPHOON_POLL_SECONDS=600

# ── JMA ────────────────────────────────────────────────────────────────────────
# Enriquecimiento por demanda y respaldo del feed de tifones.
JMA_ENABLED=true
JMA_USER_AGENT=KumaRadioAlerts/0.1 (+https://radio.kumakuma.fm)
# Intervalo mínimo por endpoint. No bajar de 300 s.
JMA_MIN_INTERVAL_SECONDS=300

# ── Cadena TTS existente ───────────────────────────────────────────────────────
# DNS del contenedor TTS en la red Docker compartida.
TTS_API_URL=http://alerts-tts:8090
# Debe ser idéntico al API_TOKEN del proyecto radio-alerts-tts.
TTS_API_TOKEN=
TTS_RESULT_TIMEOUT_SECONDS=180

# ── API interna ────────────────────────────────────────────────────────────────
# Obligatorio. Protege POST /internal/*; nginx nunca los publica.
INTERNAL_TOKEN=
# Habilita POST /internal/simulate para pruebas con fixtures.
ENABLE_SIMULATE=false

# ── Discord (solo operación) ───────────────────────────────────────────────────
# Avisos de P2P caído, JMA con errores y fallos de TTS. Vacío = desactivado.
DISCORD_WEBHOOK_URL=

# ── Almacenamiento y API ───────────────────────────────────────────────────────
HISTORY_LIMIT=50
HISTORY_DAYS=30
API_PORT=3000
DATA_DIR=/data
LOG_DIR=/logs

# ── Interfaz ───────────────────────────────────────────────────────────────────
STATION_NAME=Kuma Radio
